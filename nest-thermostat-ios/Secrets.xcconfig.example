// Copy to Secrets.xcconfig (gitignored) and fill in. No quotes.
// NOTE: xcconfig treats "//" as a comment, so never paste a URL here.

// Device Access project id (a UUID) from https://console.nest.google.com/device-access
SDM_PROJECT_ID = YOUR_DEVICE_ACCESS_PROJECT_ID

// OAuth client of type "iOS" from Google Cloud Console > APIs & Services > Credentials.
// Looks like 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID = YOUR_CLIENT_ID.apps.googleusercontent.com
// Same thing reversed: com.googleusercontent.apps.1234567890-abc123
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_CLIENT_ID

// Must match the bundle id you typed when creating the iOS OAuth client.
APP_BUNDLE_ID = com.example.NestThermostat
// Your Apple Developer team id (free personal team works for sideloading).
DEVELOPMENT_TEAM = ABCDE12345
